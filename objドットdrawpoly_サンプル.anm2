
-- 図形の設定

--select@shape:図形,図形無し=0,四角形=1,円=2,三角形=3,五角形=4,六角形=5,星型=6,ハート=7,背景=8

--[[
 x,y,zは図形の頂点。
 頂点4つを結び、その内側に図形を描写する。
 xは横 yは縦 zは奥行き
 ]]

-- 左上の頂点位置設定
--track@x0:左上頂点0x(x0),-2000,2000,-200,1 -- 横
--track@y0:左上頂点0y(y0),-2000,2000,-200,1 -- 縦
--track@z0:左上頂点0z(z0),-2000,2000,0,1 -- 奥行きなので、平面で扱う場合は0

-- 右上の頂点位置設定
--track@x1:右上頂点1x(x1),-2000,2000,200,1 -- 横
--track@y1:右上頂点1y(y1),-2000,2000,-200,1 -- 縦
--track@z1:右上頂点1z(z1),-2000,2000,0,1 -- 奥行きなので、平面で扱う場合は0

-- 右下の頂点位置設定
--track@x2:右下頂点2x(x2),-2000,2000,200,1 -- 横
--track@y2:右下頂点2y(y2),-2000,2000,200,1 -- 縦
--track@z2:右下頂点2z(z2),-2000,2000,0,1 -- 奥行きなので、平面で扱う場合は0

-- 左下の頂点位置設定
--track@x3:左下頂点3x(x3),-2000,2000,-200,1 -- 横
--track@y3:左下頂点3y(y3),-2000,2000,200,1 -- 縦
--track@z3:左下頂点3z(z3),-2000,2000,0,1 -- 奥行きなので、平面で扱う場合は0

-- 図形の設定終了

----------------------------------

----------------------------------

-- 画像の設定

--check@load_image:画像読み込み,0
--file@path:画像ファイル

--[[
u,vは画像の頂点。
頂点4つを結び、その内側に画像を描写する。
uは横 vは縦。奥行き項目は存在しない。
]]

--track@_u0:左上頂点0u(u0),-2000,2000,0,1 -- 横
--track@_v0:左上頂点0v(v0),-2000,2000,0,1 -- 縦

--track@_u1:右上頂点1u(u1),-2000,2000,0,1 -- 横
--track@_v1:右上頂点1v(v1),-2000,2000,0,1 -- 縦

--track@_u2:右下頂点2u(u2),-2000,2000,0,1 -- 横
--track@_v2:右下頂点2v(v2),-2000,2000,0,1 -- 縦

--track@_u3:左下頂点3u(u3),-2000,2000,0,1 -- 横
--track@_v3:左下頂点3v(v3),-2000,2000,0,1 -- 縦

--track@alpha:画像透明度alpha(alpha),0,1,1,0.01 -- 画像の透明度を0~1で決める。0.01刻み。

-- 画像の設定終了

------------------------------

-------------------------------

-- 図形の読み込み

if (load_image == 0) then
    if (shape == 1) then
        obj.load("figure","四角形",0xffffff,100)
    elseif (shape == 2) then
        obj.load("figure","円",0xffffff,100)
    elseif (shape == 3) then
        obj.load("figure","三角形",0xffffff,100)
    elseif (shape == 4) then
        obj.load("figure","五角形",0xffffff,100)
    elseif (shape == 5) then
        obj.load("figure","六角形",0xffffff,100)
    elseif (shape == 6) then
        obj.load("figure","星型",0xffffff,100)
    elseif (shape == 7) then
        obj.load("figure","ハート",0xffffff,100)
    elseif (shape == 8) then
        obj.load("figure","背景",0xffffff,100)
    end
end

if (load_image ~= 0) then
    obj.load("image",path)
    -- 画像を読み込んだ場合のみ、UV座標付きで描画
    shape = 0
    local image_width = obj.w
    local image_height = obj.h
    
    -- 頂点0 (x0, y0, z0) に、画像の左上 (0, 0) を割り当て、そこにトラックバーの値を追加している。
    local u0 = 0 + _u0
    local v0 = 0 + _v0 -- または obj.h （画像の上下が反転する場合）

    -- 頂点1 (x1, y1, z1) に、画像の右上 (image_width, 0) を割り当て、そこにトラックバーの値を追加している。
    local u1 = image_width + _u0
    local v1 = 0 + _v1 -- または obj.h

    -- 頂点2 (x2, y2, z2) に、画像の右下 (image_width, image_height) を割り当て、そこにトラックバーの値を追加している。
    local u2 = image_width + _u2
    local v2 = image_height + _v2 -- または 0

    -- 頂点3 (x3, y3, z3) に、画像の左下 (0, image_height) を割り当て、そこにトラックバーの値を追加している。
    local u3 = 0 + _u3
    local v3 = image_height + _v3 -- または 0

    obj.drawpoly(x0, y0, z0, x1, y1, z1, x2, y2, z2, x3, y3, z3, u0, v0, u1, v1, u2, v2, u3, v3, alpha) -- u,vの引数は省略も可能だが、ここは画像も読み込んでいる前提なので、u,vの数値を渡している。
else
    -- 画像以外の図形を読み込んだ場合、UV座標なしで描画
    obj.drawpoly(x0, y0, z0, x1, y1, z1, x2, y2, z2, x3, y3, z3) -- u,vの引数は省略も可能。画像ではなく図形の描写なので、ここではu,vを省略している。
end