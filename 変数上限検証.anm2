--track@val199:変数199,0,1000,0
--track@val200:変数200,0,1000,0

--[[
「main function has more than 200 local variables」
変数を200個以上作成すると、上記のようなエラーが出る。
そのことを確認するスクリプト。
トラックバーで作成した変数+ローカル変数+作成した関数ないの変数
]]

-- ==========================================
-- 実行確認用コード
-- ==========================================
-- もしAviUtl側の「ヘッダー処理とローカル変数自動展開」が厳密に
-- メイン関数のレジスタ空間（上限200）に加算される設計であれば、
-- 以下のコード（ファイル直下の記述）に到達する前、または到達した瞬間に
-- コンパイルエラー（"main function has more than 200 local variables" 等）
-- が発生するか、あるいはアプリケーション固有の最大トラックバー数制限に
-- 抵触してスクリプトの読み込み自体が失敗するはずです。

-- トラックバーの変数は1~200なので合計199個である。
-- そして、下記「check_val」の宣言で、ちょうど200個になる。

-- 1,テスト用に最後の変数を参照してみる

--local check_val = val199 -- 実際にはここのコメントアウトを外すとエラーが発生する。

-- だが上記の「check_val」をコメントアウトしなくても、トラックバーの項目を１つ削除し、Aviutl2を再起動するとエラーなく動くようになる。
-- なので、トラックバーで作成した変数と、コード内で記述した変数の合算が200個以上という上限に抵触すると思われる。

-- 2,グローバル変数を作成してみる。

check_global = val200 -- だがここはコメントアウトするか否かと関係なくエラーなく動く。

-- 説明通り、ローカル変数の数が200個以上となった場合にエラーになるようだ。

-- 3,「main funciton」という記述から、新たに関数を作成しそこでローカル変数を作成してみる。

--[[
local function separate_function()
    local fnc_val = 100
    return
end
]]
-- 実際にはここのコメントアウトを外すとエラーが発生する。
-- 呼び出さなくても、作成しただけでダメになるようだ。

-- 4,「main funciton」という記述から、新たに関数を作成しそこでグローバル変数を作成してみる。

--[[
local function separate_function()
    fnc_val = 100
    return
end
]]
-- 実際にはここのコメントアウトを外すとエラーが発生する。
-- この場合、グローバル変数でも、作成しただけでダメになるようだ。

-- 5,luaを読み込んでみる。

lim = require("Variable_limit")

lim.separate_function()

-- Variable_limitは、ローカル変数を内部で10個作成しているスクリプトである。
-- ゆえに本体と会わせて、209個のローカル変数を扱う事になるが動くので、.luaで読み込んだ変数は本体とは合算しないようだ。

-- スクリプトが正常に動いて変数が参照できたかは下記記述におけるログを参照すると確認できる。
print("ローカル変数「check_val」:",check_val)
print("グローバル変数「check_global」:",check_global)